# Copy to apps/api/.env and adjust.
PORT=4000
# SQLite file, relative to apps/api (or an absolute path, e.g. a mounted volume).
DATABASE_PATH=data/canadex.db
# Token for the /admin back-office. Leave empty to disable it. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# Comma-separated origins allowed to call the API when the website is hosted on another domain.
CORS_ORIGIN=
# Number of reverse proxies in front of the API (e.g. 1 behind Nginx), so rate limiting sees real client IPs.
TRUST_PROXY=0
# Optional: receive every new booking as a JSON POST (Slack, Make, Zapier, n8n, a Telegram bridge…).
NOTIFY_WEBHOOK_URL=
